<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="SauceDemo Automation Suite" verbose="1">

    <listeners>
        <listener class-name="com.amol.automation.listeners.TestListener"/>
    </listeners>

    <test name="SauceDemo Tests">

        <classes>

            
            <class name="com.amol.automation.tests.LoginTest">
                <methods>
                    <include name="verifyLogin"/>
                    <include name="verifyInvalidLogin"/>
                </methods>
            </class>

         
            <class name="com.amol.automation.tests.ProductTest">
                <methods>
                    <include name="verifyProductAddToCart"/>
                </methods>
            </class>

              
            <class name="com.amol.automation.tests.EndToEndTest">
                <methods>
                    <include name="verifyEndToEndPurchaseFlow"/>
                </methods>
            </class>

        </classes>

    </test>

</suite>
