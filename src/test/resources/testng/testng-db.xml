<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="SauceDemo Automation Suite" verbose="1">

    <listeners>
        <listener class-name="com.amol.automation.listeners.TestListener"/>
    </listeners>

    <test name="Database automation tests">

        <classes>

            <class name="com.amol.automation.tests.CustomerCrudTest">
                <methods>
					<include name="verifyCreateCustomer" />
					<include name="verifyReadCustomer" />
					<include name="verifyUpdateCustomer" />
					<include name="verifyDeleteCustomer" />
                </methods>
            </class>

        </classes>

    </test>

</suite>
