<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="SauceDemo Automation Suite"
       parallel="classes"
       thread-count="1">

    
    <listeners>
        <listener class-name="com.amol.automation.listeners.TestListener"/>
    </listeners>
    

    <test name="Login Tests">

        <classes>
            <class name="com.amol.automation.tests.LoginTest">
                <methods>
                    <include name="verifyValidLogin"/>
                
                </methods>
            </class>
        </classes>

    </test>

</suite>